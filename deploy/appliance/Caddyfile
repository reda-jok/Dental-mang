{
	# Certificates from Caddy's own authority; nothing needs the internet. Its root
	# lasts 10 years, and the server's certificate renews itself.
	local_certs
	skip_install_trust
	pki {
		ca local {
			name "Clinic server"
		}
	}
}

# Plain HTTP only hands out the certificate devices need to trust; everything else
# moves to HTTPS.
http://{$CLINIC_HOST} {
	handle /clinic.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}
	handle {
		redir https://{host}{uri} permanent
	}
}

https://{$CLINIC_HOST} {
	tls internal
	request_body {
		# A little above the app's own 15 MB upload limit.
		max_size 20MB
	}
	reverse_proxy app:3000
}
