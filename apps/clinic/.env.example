# Copy to .env and adjust. Never commit .env.

# Postgres (see docker-compose.dev.yml)
DATABASE_URL="postgresql://dental:dental@localhost:5432/dental?schema=public"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"
BETTER_AUTH_URL="http://localhost:3100"

# Clinic time zone for display and day boundaries
CLINIC_TIMEZONE="Asia/Baghdad"

# Other addresses devices use to open the app (LAN IP, hostname), comma-separated
TRUSTED_ORIGINS=""

# Where X-rays, photos and documents are stored (must be backed up)
UPLOAD_DIR="./storage/uploads"
